[user]
	name = Olle Korkmaz Zillén
	email = olle.korkmaz-zillen@airahome.com
	signingkey = /Users/olle.korkmaz-zillen/.ssh/id_ed25519.pub
[core]
  autocrlf = input
	pager = diff-so-fancy | less --tabs=4 -RFX
[color]
  ui = auto
[color "status"]
  added = green
  changed = blue bold
  untracked = red
[color "branch"]
  remote = yellow
[pull]
	rebase = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
[commit]
	verbose = true
	gpgsign = true
[gpg]
	format = ssh
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /Users/olle.korkmaz-zillen/.config/git/allowed_signers
