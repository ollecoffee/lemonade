[user]
	name = Olle Korkmaz Zillén
	email = olle.korkmaz-zillen@airahome.com
	signingkey = ~/.ssh/id_ed25519.pub
[core]
  autocrlf = input
	pager = diff-so-fancy | less --tabs=4 -RFX
[color]
  ui = auto
[color "status"]
  added = green
  changed = blue bold
  untracked = red
[color "branch"]
  remote = yellow
[pull]
	rebase = true
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
[commit]
	verbose = true
	gpgsign = true
[gpg]
	format = ssh
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch -vv
	cm = commit -m
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	unstage = restore --staged
	lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) %C(green)%G?%C(reset) %s %C(blue)(%cr) %C(dim)<%an>%C(reset)%C(auto)%d'
	last = log -1 --show-signature
	pushf = push --force-with-lease
	sync = !git fetch && git rebase origin/$(git symbolic-ref --short refs/remotes/origin/HEAD | sed \"s@origin/@@\")
	gone = !git fetch -p && git branch -vv | awk \"/: gone]/{print \\$1}\" | xargs -r git branch -D
	aliases = config --get-regexp ^alias\\.
